{
  "expo": {
    "name": "EmergencyCRMField",
    "slug": "emergency-crm-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Field Ops uses your location to report your unit's real position to command."
      }
    },
    "android": {
      "package": "com.anonymous.emergencycrmfield",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Field Ops uses your location to report your unit's real position to command."
        }
      ]
    ]
  }
}
